# Credenciales de TEST de TBO para tools/tbo/cert-cases.mjs
# Copia este archivo a .env.tbo (ignorado por Git) y rellénalo. NUNCA commitear .env.tbo.
TBO_USERNAME=
TBO_PASSWORD=
# El arnés se niega a correr contra otro host salvo con --allow-non-test-host.
TBO_BASE_URL=http://api.tbotechnology.in/TBOHolidays_HotelAPI

# Inventario. Por defecto, los 13 HotelCodes de la colección Postman.
# TBO_HOTEL_CODES=376565,1345318,...
# Sin TBO_HOTEL_CODES, run toma los hoteles de esta ciudad (TBOHotelCodeList) en lotes de 100.
# TBO_CITY_CODE=

# Fechas: hoy + offset, N noches. Sin disponibilidad, run corre el check-in 7 días (hasta 3 veces).
TBO_CHECKIN_OFFSET_DAYS=45
TBO_NIGHTS=2

# Contacto de las reservas de prueba (run, all, probe --bookings): buzón de ROL y teléfono ficticio,
# sólo dígitos con prefijo de país y sin + (p. ej. 573000000000). Nunca datos personales: van sin
# redactar en el zip que se envía a TBO.
TBO_CERT_EMAIL=
TBO_CERT_PHONE=

# <Empresa> del nombre del zip (zip, all): letras, dígitos y guiones.
TBO_COMPANY_SLUG=
# true = cada caso cancela su reserva al final de la cadena (Cancel + BookingDetail posterior).
# false = las deja activas (si TBO lo pide, Q-73); se cancelan después con `cancel <runId>`.
TBO_CANCEL_AFTER=true
