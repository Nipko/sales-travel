# Credenciales de certificación de Sabre para tools/sabre/cert-probe.mjs
# Copia este archivo a .env.sabre (que está en .gitignore) y rellénalo.
# NUNCA commitear .env.sabre. El "secret" NO se pone a mano: lo deriva el script.

SABRE_EPR=
SABRE_PASSWORD=
SABRE_PCC=

# Fijos. Cambia a api.platform.sabre.com solo cuando haya alta productiva.
SABRE_HOST=https://api.cert.platform.sabre.com
SABRE_DOMAIN=AA

# Parámetros de prueba (opcionales: el script usa hoy+30 / hoy+37 y BOG-MDE por defecto)
ROUTE_FROM=BOG
ROUTE_TO=MDE
# DEP_DATE=2026-09-24
# RET_DATE=2026-10-01
VALUE_ROUTES=BOG-MDE,BOG-LIM,LIM-CUZ,GRU-GIG,BOG-MIA,BOG-GRU
LATENCY_RUNS=8
