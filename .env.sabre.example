# Credenciales de certificación de Sabre para tools/sabre/cert-probe.mjs
# Copia este archivo a .env.sabre (que está en .gitignore) y rellénalo.
# NUNCA commitear .env.sabre.

# ─── CAMINO CORTO: si ya buscas desde Postman ───────────────────────────────
# Abre tu environment "BM API TEST CERT - EPR" en Postman y copia el valor
# de la variable `secret` (el que ya está calculado) y el de `pcc`.
SABRE_SECRET=
SABRE_PCC=

# ─── CAMINO LARGO: si prefieres que el script derive el secret ──────────────
# Deja SABRE_SECRET vacío y rellena estos. El PCC hace falta igual.
# SABRE_EPR=
# SABRE_PASSWORD=

# Fijos. Cambia a api.platform.sabre.com solo cuando haya alta productiva.
SABRE_HOST=https://api.cert.platform.sabre.com
SABRE_DOMAIN=AA

# Parámetros de prueba (opcionales: por defecto hoy+30 / hoy+37 y BOG-MDE)
ROUTE_FROM=BOG
ROUTE_TO=MDE
# DEP_DATE=2026-09-24
# RET_DATE=2026-10-01
VALUE_ROUTES=BOG-MDE,BOG-LIM,LIM-CUZ,GRU-GIG,BOG-MIA,BOG-GRU
LATENCY_RUNS=8
