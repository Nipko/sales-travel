# Renderizado por GitHub Actions desde Secrets en cada deploy.
# NO commitear el .env real. Este archivo es solo referencia de claves esperadas.

GIT_SHA=

# Postgres
POSTGRES_ADMIN_PASSWORD=   # superuser, sólo para migraciones y operaciones administrativas
APP_USER_PASSWORD=         # rol app_user (no superuser, respeta RLS) — usado por apps/api

# Redis
REDIS_PASSWORD=

# Auth
JWT_SECRET=
