{
	email admin@planetour.cloud
	servers {
		trusted_proxies static private_ranges
	}
}

# ---- Headers de seguridad reutilizables ----
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ---- API ----
api.planetour.cloud {
	encode zstd gzip
	reverse_proxy api:3000 {
		header_up X-Real-IP {remote_host}
		# IP del peer TCP real, que el cliente no puede falsificar (a diferencia de
		# CF-Connecting-IP, que es sólo una cabecera). El throttler la usa como segunda
		# clave para que forjar CF-Connecting-IP no alcance para estrenar cupo.
		header_up -X-Edge-Peer-IP
		header_up X-Edge-Peer-IP {remote_host}
	}
	import security_headers
}

# ---- Panel agencia (B2B) ----
app.planetour.cloud {
	encode zstd gzip
	reverse_proxy web-b2b:3001 {
		header_up X-Real-IP {remote_host}
		# IP del peer TCP real, que el cliente no puede falsificar (a diferencia de
		# CF-Connecting-IP, que es sólo una cabecera). El throttler la usa como segunda
		# clave para que forjar CF-Connecting-IP no alcance para estrenar cupo.
		header_up -X-Edge-Peer-IP
		header_up X-Edge-Peer-IP {remote_host}
	}
	import security_headers
}

