NODE_ENV=development
PORT=3000
APP_VERSION=dev
# Apagado ordenado: espera máxima, en ms, a las peticiones y sagas en curso tras una SIGTERM antes
# de cerrar el pool y la cola (0 a 300000; 125000 por defecto). En producción va por debajo del
# stop_grace_period del contenedor (130 s). Un segundo Ctrl+C sale sin esperar.
SHUTDOWN_DRAIN_TIMEOUT_MS=125000
# Book de hoteles con órdenes: cuánto espera la petición a la saga antes de responder 202 y dejar
# que la web consulte la orden (0 a 60000; 25000 por defecto). El Book sigue en el proceso.
HOTEL_BOOK_SYNC_WAIT_MS=25000

# DB (Postgres 16 + TimescaleDB + pgvector)
# Usar el rol app_user (no superuser, respeta RLS)
DATABASE_URL=postgresql://app_user:pass@host:5432/sales_travel
DATABASE_POOL_MAX=10

# Redis — cola de reintentos de post-venta (BullMQ). Sin REDIS_HOST, el worker no arranca
# (degradación elegante: queda el reintento manual).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=

# Clave maestra para cifrar credenciales BYOC de proveedores en provider_accounts.
# Debe ser base64 de 32 bytes. Nunca guardar la clave real ni credenciales Sabre en Git.
PROVIDER_CREDENTIALS_KEY=

# Bóveda de payloads de proveedor (RQ/RS completos para soporte y certificación, migración 0043).
# Clave PROPIA, distinta de PROVIDER_CREDENTIALS_KEY: base64 de 32 bytes
# (`openssl rand -base64 32`). Vacía = bóveda apagada: los ACL no guardan cuerpos y nada más cambia.
# Para rotar: la vigente pasa a _PREVIOUS y se carga una nueva; la anterior se quita cuando vence
# la retención. La retención es en días, de 1 a 90 (30 por defecto).
PROVIDER_PAYLOADS_KEY=
PROVIDER_PAYLOADS_KEY_PREVIOUS=
PROVIDER_PAYLOADS_RETENTION_DAYS=30

# Notificaciones por email
# APP_WEB_URL: base del panel para el enlace de verificación de correo.
APP_WEB_URL=https://app.planetour.cloud
# SMTP por defecto del sistema (fallback cuando una agencia no configura su propio correo).
# Cada agencia puede definir el suyo (BYO-email) desde "Mi Red" → Email.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=PlaneTour

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sales-travel-api
