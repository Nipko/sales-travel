NODE_ENV=development
PORT=3000
APP_VERSION=dev

# DB (Postgres 16 + TimescaleDB + pgvector)
# Usar el rol app_user (no superuser, respeta RLS)
DATABASE_URL=postgresql://app_user:pass@host:5432/sales_travel
DATABASE_POOL_MAX=10

# Redis — cola de reintentos de post-venta (BullMQ). Sin REDIS_HOST, el worker no arranca
# (degradación elegante: queda el reintento manual).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=

# Notificaciones por email
# APP_WEB_URL: base del panel para el enlace de verificación de correo.
APP_WEB_URL=https://app.planetour.cloud
# SMTP por defecto del sistema (fallback cuando una agencia no configura su propio correo).
# Cada agencia puede definir el suyo (BYO-email) desde "Mi Red" → Email.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=PlaneTour

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sales-travel-api
