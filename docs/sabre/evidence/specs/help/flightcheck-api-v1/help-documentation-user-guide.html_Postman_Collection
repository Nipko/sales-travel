    "programs": [
      {
        "distributionModels": [
          "NDC"
        ],
        "type": "Account Code",
        "values": [
          "ACC33"
        ],
        "companyIdType": "ABN",
        "airlineCode": "RJ"
      }
    ],
    "returnTaxBreakdown": false
  },
  "retailing": {
    "returnOfferAttributes": [
      "Baggage",
      "Carbon Emissions"
    ]
  },
  "travelers": [
    {
