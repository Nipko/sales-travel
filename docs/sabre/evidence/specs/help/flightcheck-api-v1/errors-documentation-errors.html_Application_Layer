      {
        "category": "BAD_REQUEST",
        "type": "REQUIRED_FIELD_MISSING",
        "description": "Client did not provide required data. See fieldName for the item expected in the request.",
        "fieldName": "currencyCode"
      }
    ]
}</code></pre>
</div>
</div></div></td>
</tr>
